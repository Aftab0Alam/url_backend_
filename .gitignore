# ======================================
# 🧱 Node.js / Express Backend .gitignore
# ======================================

# Node dependencies
node_modules/

# Environment variables (secret keys, DB URIs)
.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/

# Build / Output folders (if you transpile or bundle)
dist/
build/
coverage/

# Temporary / cache files
*.tmp
*.swp
*.bak
*.old
*.orig

# Lock files (optional — keep if you use npm ci)
# package-lock.json
# yarn.lock

# Docker
.dockerignore

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local
